{{/*
Selector labels of the operator Deployment/pods created by the hiro-operator
subchart (dist/chart, aliased "hiro-operator" — see Chart.yaml). Templates in
THIS chart that need to target those pods (e.g. the webhook Service) use this
instead of hardcoding the subchart's naming convention in multiple places.
*/}}
{{- define "hiro-adaptive-platform.operatorSelectorLabels" -}}
app.kubernetes.io/name: hiro-operator
control-plane: controller-manager
{{- end }}

{{/*
Error message for webhook.enable=true with scheduler.mode != "plugin".
Checked at the top of templates/webhook/manifests.yaml (the one guarded
by webhook.enable), same pattern as the "required" messages in
templates/scheduler-plugin/*.yaml — message text lives here, the actual
if/fail check stays next to the resource it protects.
*/}}
{{- define "hiro-adaptive-platform.errors.webhookRequiresPlugin" -}}
webhook.enable=true requires scheduler.mode: plugin. The webhook sets spec.schedulerName on new pods so they route to the scheduler-plugin Deployment; with mode=none nothing claims that name (pods stick Pending), and with mode=extender the default scheduler already handles every pod via the extender patch, so schedulerName would misroute them instead. This mirrors deploy_full_stack.sh, where the webhook has no independent toggle — it's driven 1:1 by DEPLOY_SCHEDULER_PLUGIN.
{{- end }}

{{/*
The hiro-operator subchart's fullname, recomputed here with the same rules as
its "hiro-adaptive-orchestrator.fullname" helper (dist/chart/templates/_helpers.tpl).
The chart name is the alias ("hiro-operator") — see the note in Chart.yaml.
This is what lets templates in THIS chart name the operator's Service and
ServiceAccount at render time, with no cluster lookup.
*/}}
{{- define "hiro-adaptive-platform.operatorFullname" -}}
{{- $op := index .Values "hiro-operator" }}
{{- if $op.fullnameOverride }}
{{- $op.fullnameOverride | trunc 63 | trimSuffix "-" }}
{{- else }}
{{- $name := default "hiro-operator" $op.nameOverride }}
{{- if contains $name .Release.Name }}
{{- .Release.Name | trunc 63 | trimSuffix "-" }}
{{- else }}
{{- printf "%s-%s" .Release.Name $name | trunc 63 | trimSuffix "-" }}
{{- end }}
{{- end }}
{{- end }}

{{/*
Mirror of the subchart's "hiro-adaptive-orchestrator.resourceName": the
fullname plus a suffix, truncated to Kubernetes' 63-character limit.
Takes a dict with .suffix and .context (the root context).
*/}}
{{- define "hiro-adaptive-platform.operatorResourceName" -}}
{{- $fullname := include "hiro-adaptive-platform.operatorFullname" .context }}
{{- $maxLen := sub 62 (len .suffix) | int }}
{{- if gt (len $fullname) $maxLen }}
{{- printf "%s-%s" (trunc $maxLen $fullname | trimSuffix "-") .suffix | trunc 63 | trimSuffix "-" }}
{{- else }}
{{- printf "%s-%s" $fullname .suffix | trunc 63 | trimSuffix "-" }}
{{- end }}
{{- end }}

{{/*
Name of the operator's PlacementServer Service (generated by the subchart from
config/manager/placement_service_patch.yaml, always on port 8090).
*/}}
{{- define "hiro-adaptive-platform.placementServiceName" -}}
{{- include "hiro-adaptive-platform.operatorResourceName" (dict "suffix" "controller-manager-placement-service" "context" .) }}
{{- end }}

{{/*
URL the scheduler plugin calls: scheduler.plugin.placementServer.url when set,
otherwise the operator's own placement Service.
*/}}
{{- define "hiro-adaptive-platform.placementServerURL" -}}
{{- if .Values.scheduler.plugin.placementServer.url }}
{{- .Values.scheduler.plugin.placementServer.url }}
{{- else }}
{{- printf "http://%s.%s.svc.cluster.local:8090" (include "hiro-adaptive-platform.placementServiceName" .) .Release.Namespace }}
{{- end }}
{{- end }}
