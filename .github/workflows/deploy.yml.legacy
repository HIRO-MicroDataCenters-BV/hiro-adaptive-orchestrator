# Archived — replaced by deploy.yml, which pulls the chart/images from GHCR
# directly instead of checking out this repo and running its Makefile.
# Kept for reference only; .yml.legacy is not a workflow extension GitHub
# Actions scans, so this file never runs.
#
# name: Deploy to Target Cluster
# #
# # Triggered when release.yml publishes a GitHub Release, or manually for a
# # redeploy of a past version without rebuilding anything.
# #
# # ─── Secrets ────────────────────────────────────────────────────────────
# #   TARGET_KUBECONFIG   Required. Base64-encoded kubeconfig for the target
# #                       cluster (`kubectl config view --raw | base64`).
# #
# # ─── Repo Variables (Settings > Secrets and variables > Actions) ────────
# #   TARGET_NAMESPACE             k8s namespace for the release  (default: hiro-adaptive-orchestrator-system)
# #   TARGET_RELEASE_NAME          Helm release name              (default: hiro-adaptive-platform)
# #   SCHED_K8S_VERSION            Scheduler image's target K8s minor version (default: v1.35.0)
# #   SCHEDULER_MODE                none | plugin | extender        (default: none)
# #   WEBHOOK_ENABLE                true | false                    (default: false)
# #   WEBHOOK_CERT_MANAGER_ENABLE   true | false                    (default: false)
# #   PREREQ_CERT_MANAGER_ENABLE    true | false                    (default: false)
# #   PREREQ_METRICS_SERVER_ENABLE  true | false                    (default: false)
# #   PREREQ_PROMETHEUS_ENABLE      true | false                    (default: false)
# #   MOCK_AGENT_ENABLE             true | false                    (default: false)
# #   HELM_EXTRA_VALUES             Catch-all extra --set/-f args, applied on every run
# #
# # ─── workflow_dispatch input ─────────────────────────────────────────────
# #   version   Required for a manual run. Version tag to deploy (e.g. v1.4.0).
