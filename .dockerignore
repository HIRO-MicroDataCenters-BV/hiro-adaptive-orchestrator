# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore everything by default and re-include only needed files
**

# Re-include Go source files (but not *_test.go)
!**/*.go
**/*_test.go

# Re-include Go module files
!go.mod
!go.sum

# Re-include scheduler-plugin module files and the version-pin script.
# These are excluded by the ** rule above but required by scheduler-plugin/Dockerfile.
!scheduler-plugin/go.mod
!scheduler-plugin/go.sum
!scheduler-plugin/pin_k8s_version.sh
